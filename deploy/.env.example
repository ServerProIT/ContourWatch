# External browser AND agent URL. TLS terminates on Nginx Proxy Manager.
PUBLIC_URL=https://monitor.example.com

# With a separate NPM VM, set the panel VM's private IPv4 address here.
# Loopback is the safe default. 0.0.0.0 is not needed.
APP_BIND_IP=127.0.0.1
APP_PORT=8080

# Actual source IP of NPM as seen by the container. Exact IPs, comma-separated.
# Leave empty to ignore forwarded IPs; this shares rate limits behind NPM.
TRUSTED_PROXY_IPS=

# Changing this name starts an empty database unless data is migrated.
DATA_VOLUME_NAME=contourwatch-data
